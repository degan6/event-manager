<% occurrence = local_assigns[:occurrence] %>
<% compact = local_assigns.fetch(:compact, false) %>
<% follow_label = local_assigns[:label] || (occurrence ? "Follow this date" : "Follow") %>
<% following_label = local_assigns[:following_label] || (occurrence ? "Following this date" : "Following") %>
<% if favorites_enabled? %>
  <%= turbo_frame_tag favorite_frame_id(event, occurrence), class: "d-inline-block" do %>
    <% favorite = current_favorite(event: event, occurrence: occurrence) %>
    <% if user_signed_in? && occurrence && favorite.nil? && following_whole_event?(event) %>
      <span class="badge text-bg-warning"><i class="bi bi-star-fill" aria-hidden="true"></i> Following every date</span>
    <% elsif user_signed_in? && favorite %>
      <%= button_to favorite_path(favorite), method: :delete,
            class: "btn btn-sm btn-outline-warning #{'px-2' if compact}",
            title: "Stop following",
            aria: { label: "Stop following #{event.title}" } do %>
        <i class="bi bi-star-fill" aria-hidden="true"></i>
        <% unless compact %><%= following_label %><% end %>
      <% end %>
    <% elsif user_signed_in? %>
      <%= button_to favorites_path, method: :post,
            params: { event_id: event.id, event_occurrence_id: occurrence&.id }.compact,
            class: "btn btn-sm btn-outline-secondary #{'px-2' if compact}",
            title: follow_label,
            aria: { label: "#{follow_label} #{event.title}" } do %>
        <i class="bi bi-star" aria-hidden="true"></i>
        <% unless compact %><%= follow_label %><% end %>
      <% end %>
    <% else %>
      <%= button_to login_favorites_path, method: :post,
            params: { return_to: request.fullpath },
            class: "btn btn-sm btn-outline-secondary #{'px-2' if compact}",
            title: "Log in to follow",
            aria: { label: "Log in to follow #{event.title}" } do %>
        <i class="bi bi-star" aria-hidden="true"></i>
        <% unless compact %>Log in to follow<% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
