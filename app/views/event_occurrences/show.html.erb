<%# SEO Meta Tags %>
<% page_title "#{@event.title} - #{@occurrence.occurs_at.strftime('%B %d, %Y')}" %>
<% page_description @occurrence.description %>
<% og_type 'event' %>
<% canonical_url event_occurrence_url(@occurrence) %>
<% if @occurrence.banner.attached? %>
  <% og_image preview_image_url(@occurrence.banner) %>
<% end %>

<%# JSON-LD Structured Data for this specific occurrence %>
<% content_for :json_ld do %>
  <script type="application/ld+json"><%= event_json_ld(@event, @occurrence) %></script>
  <script type="application/ld+json"><%= breadcrumb_json_ld([
    { name: 'Home', url: root_url },
    { name: 'Events', url: events_url },
    { name: @event.title, url: event_url(@event) },
    { name: @occurrence.occurs_at.strftime('%B %d, %Y'), url: event_occurrence_url(@occurrence) }
  ]) %></script>
<% end %>

<article class="row" itemscope itemtype="https://schema.org/Event">
  <div class="col-lg-8">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to "Events", events_path %></li>
        <li class="breadcrumb-item"><%= link_to @event.title, event_path(@event) %></li>
        <li class="breadcrumb-item active" aria-current="page">
          <% if @occurrence.status == 'postponed' && @occurrence.postponed_until %>
            <span class="text-decoration-line-through text-muted"><%= @occurrence.occurs_at.strftime('%B %d, %Y') %></span>
          <% else %>
            <%= @occurrence.occurs_at.strftime('%B %d, %Y') %>
          <% end %>
        </li>
      </ol>
    </nav>

    <% if @occurrence.banner.attached? %>
      <figure class="mb-4 occurrence-banner">
        <%= image_tag @occurrence.banner, class: "img-fluid rounded", style: "width: 100%; max-height: 400px; object-fit: cover;", alt: "Banner image for #{@event.title}", loading: "lazy", itemprop: "image" %>
        <% if @occurrence.custom_banner? %>
          <figcaption class="text-muted mt-1"><small><i class="bi bi-image-fill" aria-hidden="true"></i> Custom banner for this occurrence</small></figcaption>
        <% end %>
      </figure>
    <% end %>

    <header class="d-flex justify-content-between align-items-start mb-3">
      <h1 itemprop="name"><%= @event.title %></h1>
      <% if @occurrence.status != 'active' %>
        <span class="badge bg-<%= case @occurrence.status
                                   when 'postponed' then 'warning'
                                   when 'relocated' then 'info'
                                   else 'danger'
                                   end %> fs-5">
          <%= @occurrence.status.titleize %>
        </span>
      <% end %>
    </header>
    <div class="d-flex flex-wrap gap-2 mb-3">
      <%= render "favorites/toggle", event: @event, occurrence: @occurrence %>
      <%= render "favorites/toggle", event: @event, label: "Follow every date", following_label: "Following every date" %>
    </div>

    <% if @exclusive_conflicts&.any? %>
      <div class="alert alert-danger" role="alert">
        <h2 class="alert-heading h6"><i class="bi bi-slash-circle" aria-hidden="true"></i> Conflicts with an exclusive event</h2>
        <ul class="mb-0">
          <% @exclusive_conflicts.each do |conflict| %>
            <li><%= link_to SchedulingCopy.exclusive_sentence(conflict), event_path(conflict.event), class: "alert-link" %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <p class="h5 text-muted mb-4" itemprop="startDate" content="<%= (@occurrence.postponed_until || @occurrence.occurs_at).iso8601 %>">
      <% if @occurrence.status == 'postponed' && @occurrence.postponed_until %>
        <span class="text-decoration-line-through"><%= @occurrence.occurs_at.strftime('%A, %B %d, %Y at %I:%M %p') %></span>
        <span class="visually-hidden"> (original date and time, no longer valid)</span>
      <% else %>
        <%= @occurrence.occurs_at.strftime('%A, %B %d, %Y at %I:%M %p') %>
      <% end %>
    </p>

    <% if @occurrence.status == 'postponed' && @occurrence.postponed_until %>
      <div class="alert alert-warning" role="alert">
        <h2 class="alert-heading h5">
          <i class="bi bi-clock-history" aria-hidden="true"></i> Occurrence Postponed
        </h2>
        <p class="mb-0"><strong>Rescheduled to:</strong> <%= @occurrence.postponed_until.strftime('%B %d, %Y at %I:%M %p') %></p>
        <% if @occurrence.cancellation_reason.present? %>
          <hr>
          <p class="mb-0"><strong>Reason:</strong> <%= @occurrence.cancellation_reason %></p>
        <% end %>
      </div>
    <% elsif @occurrence.status == 'cancelled' %>
      <div class="alert alert-danger" role="alert">
        <h2 class="alert-heading h5">
          <i class="bi bi-x-circle" aria-hidden="true"></i> Occurrence Cancelled
        </h2>
        <% if @occurrence.relocated_to.present? %>
          <p class="mb-2"><strong><i class="bi bi-geo-alt-fill"></i> Was relocated to:</strong> <%= @occurrence.relocated_to %></p>
        <% end %>
        <% if @occurrence.cancellation_reason.present? %>
          <p class="mb-0"><strong>Reason:</strong> <%= @occurrence.cancellation_reason %></p>
        <% elsif @occurrence.relocated_to.blank? %>
          <p class="mb-0">This occurrence has been cancelled.</p>
        <% end %>
      </div>
    <% elsif @occurrence.status == 'relocated' %>
      <div class="alert alert-info" role="alert">
        <h2 class="alert-heading h5">
          <i class="bi bi-geo-alt" aria-hidden="true"></i> Event Relocated
        </h2>
        <p class="mb-0"><strong>New Location:</strong> <%= @occurrence.relocated_to %></p>
        <% if @occurrence.cancellation_reason.present? %>
          <hr>
          <p class="mb-0"><strong>Note:</strong> <%= @occurrence.cancellation_reason %></p>
        <% end %>
        <hr>
        <p class="mb-0 text-muted small">This event is no longer at our space but continues at the new location.</p>
      </div>
    <% end %>

    <% if rsvp_collecting?(@occurrence) %>
      <p class="mb-3"><%= rsvp_required_badge(extra_class: 'fs-6') %></p>
    <% end %>

    <%= render 'rsvp_panel', occurrence: @occurrence, current_rsvp: @current_rsvp %>

    <section class="card mb-4">
      <div class="card-body">
        <h2 class="card-title h5">Description</h2>
        <div class="card-text" itemprop="description"><%= formatted_event_description(@occurrence) %></div>
        
        <% if (safe_more_info_url = safe_url(@event.more_info_url)) %>
          <div class="mt-3">
            <%= link_to safe_more_info_url, target: "_blank", rel: "noopener noreferrer", class: "btn btn-outline-primary" do %>
              <i class="bi bi-box-arrow-up-right"></i> Learn More About This Event
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <aside class="col-lg-4">
    <section class="card mb-3">
      <div class="card-body">
        <h2 class="card-title h5">Occurrence Details</h2>
        <dl class="row mb-0">
          <dt class="col-sm-5">Date:</dt>
          <dd class="col-sm-7">
            <% if @occurrence.status == 'postponed' %>
              <span class="text-decoration-line-through text-muted"><%= @occurrence.occurs_at.strftime('%B %d, %Y') %></span>
              <% if @occurrence.postponed_until %>
                <br>
                <span class="text-body"><%= @occurrence.postponed_until.strftime('%B %d, %Y') %> <span class="small text-muted">(rescheduled)</span></span>
              <% end %>
            <% else %>
              <%= @occurrence.occurs_at.strftime('%B %d, %Y') %>
            <% end %>
          </dd>

          <dt class="col-sm-5">Time:</dt>
          <dd class="col-sm-7">
            <% if @occurrence.status == 'postponed' && @occurrence.postponed_until %>
              <span class="text-decoration-line-through text-muted"><%= @occurrence.occurs_at.strftime('%I:%M %p') %> to <%= (@occurrence.occurs_at + @occurrence.duration.minutes).strftime('%I:%M %p') %></span>
              <br>
              <span class="text-body"><%= @occurrence.postponed_until.strftime('%I:%M %p') %> to <%= (@occurrence.postponed_until + @occurrence.duration.minutes).strftime('%I:%M %p') %> <span class="small text-muted">(rescheduled)</span></span>
            <% elsif @occurrence.status == 'postponed' %>
              <span class="text-decoration-line-through text-muted"><%= @occurrence.occurs_at.strftime('%I:%M %p') %> to <%= (@occurrence.occurs_at + @occurrence.duration.minutes).strftime('%I:%M %p') %></span>
            <% else %>
              <%= @occurrence.occurs_at.strftime('%I:%M %p') %> to <%= (@occurrence.occurs_at + @occurrence.duration.minutes).strftime('%I:%M %p') %>
            <% end %>
          </dd>

          <% if @occurrence.event_location.present? %>
            <dt class="col-sm-5"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Location:</dt>
            <dd class="col-sm-7">
              <%= @occurrence.event_location.name %>
              <% if @occurrence.location_id.present? %>
                <small class="text-muted d-block">(Custom for this occurrence)</small>
              <% end %>
            </dd>
          <% end %>

          <dt class="col-sm-5">Event:</dt>
          <dd class="col-sm-7"><%= link_to @event.title, event_path(@event) %></dd>

          <% if @event.hosts.any? %>
            <dt class="col-sm-5">Hosts:</dt>
            <dd class="col-sm-7"><%= @event.hosts.map { |h| h.name || h.email }.join(', ') %></dd>
          <% end %>

          <% if rsvp_collecting?(@occurrence) && @occurrence.effective_capacity %>
            <dt class="col-sm-5">Capacity:</dt>
            <dd class="col-sm-7">
              <%= rsvp_capacity_summary(@occurrence) %>
              <span class="d-block small text-muted"><%= @occurrence.spots_taken %> taken · <%= @occurrence.effective_capacity %> total</span>
            </dd>
          <% end %>

          <dt class="col-sm-5">Open To:</dt>
          <dd class="col-sm-7"><%= open_to_badge(@event) %></dd>

          <dt class="col-sm-5">Status:</dt>
          <dd class="col-sm-7"><%= @occurrence.status.titleize %></dd>

          <% if @event.requires_mask %>
            <dt class="col-sm-5">Safety:</dt>
            <dd class="col-sm-7">
              <span class="badge bg-info">
                <i class="bi bi-shield-fill-check" aria-hidden="true"></i> Masks Required
              </span>
            </dd>
          <% end %>
        </dl>
      </div>
    </section>

    <%= render 'shared/contact_hosts', url: event_occurrence_host_contact_path(@occurrence) %>

    <% if user_signed_in? && (current_user.admin? || @event.hosted_by?(current_user)) %>
      <section class="card mb-3">
        <div class="card-body">
          <h2 class="card-title h5">Manage Occurrence</h2>
          <div class="d-grid gap-2">
            <%= link_to "Edit Details", edit_event_occurrence_path(@occurrence), class: "btn btn-warning" %>
            
            <% if @occurrence.status == 'active' %>
              <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#postponeModal">
                Postpone This Occurrence
              </button>
              <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#relocateModal">
                Mark as Relocated
              </button>
              <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                Cancel This Occurrence
              </button>
            <% else %>
              <%= form_with url: reactivate_event_occurrence_path(@occurrence), method: :post do %>
                <%= render "shared/exclusive_override_field", prefix: "reactivate_#{@occurrence.id}" %>
                <%= submit_tag "Reactivate", class: "btn btn-success" %>
              <% end %>
            <% end %>
            
            <%= button_to "Delete This Occurrence", event_occurrence_path(@occurrence), 
                method: :delete, 
                class: "btn btn-danger",
                form: { data: { turbo_confirm: "Delete this occurrence? The event series will remain." } } %>
          </div>
        </div>
      </section>

      <% if current_user.admin? %>
        <section class="card mb-3">
          <div class="card-body">
            <h2 class="card-title h5">Admin Actions</h2>
            <div class="d-grid gap-2">
              <%= button_to send_host_reminder_event_occurrence_path(@occurrence),
                  method: :post,
                  class: "btn btn-outline-info",
                  form: { data: { turbo_confirm: "Send host reminder email now for this occurrence?" } } do %>
                <i class="bi bi-envelope-arrow-up" aria-hidden="true"></i> Send Host Reminder Now
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    <% end %>

    <section class="card mb-3">
      <div class="card-body">
        <h2 class="card-title h5">Add to Calendar</h2>
        <p class="card-text small text-muted">Add this occurrence to your personal calendar</p>
        <div class="d-grid gap-2">
          <%= link_to google_calendar_url(@occurrence), target: "_blank", rel: "noopener noreferrer", class: "btn btn-outline-primary", "aria-label": "Add to Google Calendar" do %>
            <i class="bi bi-google" aria-hidden="true"></i> Google Calendar
          <% end %>
          <%= link_to apple_calendar_url(@occurrence), class: "btn btn-outline-secondary", "aria-label": "Add to Apple Calendar (downloads .ics file)" do %>
            <i class="bi bi-apple" aria-hidden="true"></i> Apple Calendar
          <% end %>
          <%= link_to outlook_calendar_url(@occurrence), target: "_blank", rel: "noopener noreferrer", class: "btn btn-outline-primary", "aria-label": "Add to Outlook.com Calendar" do %>
            <i class="bi bi-microsoft" aria-hidden="true"></i> Outlook.com
          <% end %>
          <div class="btn-group" role="group">
            <%= link_to office365_calendar_url(@occurrence), target: "_blank", rel: "noopener noreferrer", class: "btn btn-outline-secondary btn-sm", "aria-label": "Add to Office 365 Calendar" do %>
              <i class="bi bi-building" aria-hidden="true"></i> Office 365
            <% end %>
            <%= link_to yahoo_calendar_url(@occurrence), target: "_blank", rel: "noopener noreferrer", class: "btn btn-outline-secondary btn-sm", "aria-label": "Add to Yahoo Calendar" do %>
              <i class="bi bi-calendar-plus" aria-hidden="true"></i> Yahoo
            <% end %>
          </div>
        </div>
      </div>
    </section>
  </aside>
</article>

<nav class="mt-3" aria-label="Back navigation">
  <%= link_to "← Back to Event", event_path(@event), class: "btn btn-secondary" %>
  <%= link_to "View Calendar", calendar_path, class: "btn btn-outline-secondary" %>
</nav>

<!-- Postpone Modal -->
<div class="modal fade" id="postponeModal" tabindex="-1" aria-labelledby="postponeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <%= form_with url: postpone_event_occurrence_path(@occurrence), method: :post do |f| %>
        <div class="modal-header">
          <h2 class="modal-title h5" id="postponeModalLabel">Postpone This Occurrence</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="postponed_until" class="form-label">Postpone Until</label>
            <input type="datetime-local" 
                   class="form-control" 
                   id="postponed_until"
                   name="postponed_until"
                   value="<%= 1.week.from_now.strftime('%Y-%m-%dT%H:%M') %>">
          </div>
          <div class="mb-3">
            <label for="postpone_reason" class="form-label">Reason (Optional)</label>
            <textarea class="form-control" id="postpone_reason" name="reason" rows="3"></textarea>
          </div>
          <%= render "shared/exclusive_override_field", prefix: "occurrence_#{@occurrence.id}" %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Postpone", class: "btn btn-warning" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <%= form_with url: cancel_event_occurrence_path(@occurrence), method: :post do |f| %>
        <div class="modal-header bg-danger text-white">
          <h2 class="modal-title h5" id="cancelModalLabel">Cancel This Occurrence</h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-info" role="note">
            This will only cancel this specific occurrence. The event series will continue.
          </div>
          <div class="mb-3">
            <label for="cancel_reason" class="form-label">Reason (Optional)</label>
            <textarea class="form-control" id="cancel_reason" name="reason" rows="3"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Don't Cancel</button>
          <%= f.submit "Cancel Occurrence", class: "btn btn-danger" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Relocate Modal -->
<div class="modal fade" id="relocateModal" tabindex="-1" aria-labelledby="relocateModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <%= form_with url: relocate_event_occurrence_path(@occurrence), method: :post do |f| %>
        <div class="modal-header bg-info text-white">
          <h2 class="modal-title h5" id="relocateModalLabel">Mark as Relocated</h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-secondary" role="note">
            Use this when an event has moved to a different venue. The event will be marked as relocated and visitors will see the new location.
          </div>
          <div class="mb-3">
            <label for="relocated_to" class="form-label">New Location <span class="text-danger">*</span></label>
            <input type="text" 
                   class="form-control" 
                   id="relocated_to"
                   name="relocated_to"
                   placeholder="e.g., Community Center, 123 Main St"
                   required>
            <div class="form-text">Enter the name and/or address of the new venue</div>
          </div>
          <div class="mb-3">
            <label for="relocate_reason" class="form-label">Additional Notes (Optional)</label>
            <textarea class="form-control" id="relocate_reason" name="reason" rows="3" placeholder="Any additional information about the move..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Mark as Relocated", class: "btn btn-info" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
