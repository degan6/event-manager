<p><strong><%= @event.title %></strong> <%= schedule_change_sentence(@kind) %>.</p>
<% if @previous_start.present? && @occurrence %>
  <p>It was <%= @previous_start.strftime('%A, %B %d, %Y at %I:%M %p') %>. It is now <%= @occurrence.occurs_at.strftime('%A, %B %d, %Y at %I:%M %p') %>.</p>
<% elsif @occurrence&.status == 'postponed' && @occurrence.postponed_until.present? %>
  <p>It was <%= @occurrence.occurs_at.strftime('%A, %B %d, %Y at %I:%M %p') %>. It is now <%= @occurrence.postponed_until.strftime('%A, %B %d, %Y at %I:%M %p') %>.</p>
<% else %>
  <%= render "when", event: @event, occurrence: @occurrence %>
<% end %>
<% if @previous_venue.present? %>
  <p>It was at <%= @previous_venue %>. It is now at <%= @occurrence&.venue_name || 'a new location' %>.</p>
<% end %>
<% if @reason.present? %>
  <p>Reason: <%= @reason %></p>
<% end %>
<%= render "footer" %>
