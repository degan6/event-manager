<p>This is your <%= @kind == '7d' ? 'one week' : 'one day' %> reminder for <strong><%= @event.title %></strong>.</p>
<%= render "when", event: @event, occurrence: @occurrence %>
<% if @occurrence&.rsvp_open? %>
  <p><%= link_to "RSVP", event_occurrence_url(@occurrence) %></p>
<% end %>
<%= render "footer" %>
