<% if @event.allow_host_contact? && policy(@event).show? %>
  <section class="card mb-3" id="contact-hosts">
    <div class="card-body">
      <h2 class="card-title h5">Contact hosts</h2>
      <p class="card-text small text-muted mb-3">
        Send a message to the people hosting this event. They reply by email.
      </p>
      <%= form_with url: url, method: :post, local: true do %>
        <div class="mb-2">
          <label class="form-label" for="host_contact_name">Name</label>
          <input class="form-control" type="text" name="name" id="host_contact_name" maxlength="120" autocomplete="name" value="<%= current_user&.name %>">
        </div>
        <div class="mb-2">
          <label class="form-label" for="host_contact_email">Email</label>
          <input class="form-control" type="email" name="email" id="host_contact_email" required autocomplete="email" value="<%= current_user&.email %>">
        </div>
        <div class="mb-3">
          <label class="form-label" for="host_contact_message">Message</label>
          <textarea class="form-control" name="message" id="host_contact_message" required maxlength="4000" rows="4"></textarea>
        </div>
        <div class="visually-hidden" aria-hidden="true">
          <label for="host_contact_company_website">Company website</label>
          <input type="text" name="company_website" id="host_contact_company_website" tabindex="-1" autocomplete="off">
        </div>
        <button class="btn btn-primary w-100" type="submit">
          <i class="bi bi-envelope" aria-hidden="true"></i> Contact hosts
        </button>
      <% end %>
    </div>
  </section>
<% end %>
