<% wizard_steps = [['Details', 'bi-info-circle'], ['Images', 'bi-images'], ['Scheduling', 'bi-calendar-event'],
                   ['Visibility', 'bi-eye'], ['Promotion', 'bi-megaphone']] %>

<div id="event-wizard" data-total-steps="<%= wizard_steps.size %>">
  <% if event.errors.any? %>
    <div class="alert alert-danger" role="alert" aria-live="assertive">
      <h2 class="h4"><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h2>
      <ul>
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Wizard Progress Breadcrumbs -->
  <nav aria-label="Event wizard progress" class="mb-4">
    <ol class="wizard-steps d-flex justify-content-between list-unstyled mb-0 position-relative">
      <% wizard_steps.each_with_index do |(label, _icon), index| %>
        <% number = index + 1 %>
        <li class="wizard-step flex-fill text-center" data-step="<%= number %>">
          <button type="button" class="wizard-step-btn btn btn-link text-decoration-none p-0 w-100" data-goto-step="<%= number %>">
            <span class="wizard-step-number d-inline-flex align-items-center justify-content-center rounded-circle mb-1"><%= number %></span>
            <span class="wizard-step-label d-block small"><%= label %></span>
          </button>
        </li>
      <% end %>
    </ol>
  </nav>

<%= form_with(model: event, local: true, multipart: true, class: "needs-validation event-wizard-form", id: "event-wizard-form", "aria-label": "Event form") do |f| %>
  <!-- Step 1: Details -->
  <div class="wizard-panel" data-step="1">
    <div class="card mb-3">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Event Details</h5>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <%= f.label :title, class: "form-label" %>
          <%= f.text_field :title, class: "form-control", required: true, placeholder: "Weekly Meetup" %>
        </div>

        <%= render "events/description_fields",
                   f: f,
                   html_field: :description_html,
                   text_field: :description,
                   sync_param: :sync_description %>

        <div class="mb-3">
          <%= f.label :more_info_url, "More Info URL (Optional)", class: "form-label" %>
          <%= f.url_field :more_info_url, class: "form-control", placeholder: "https://example.com/event-details" %>
          <small class="form-text text-muted">
            <i class="bi bi-link-45deg" aria-hidden="true"></i> Link where attendees can learn more
          </small>
        </div>

        <div class="mb-3">
          <div class="form-check">
            <%= f.check_box :requires_mask, class: "form-check-input" %>
            <%= f.label :requires_mask, "Masks Required", class: "form-check-label" %>
            <div class="form-text">
              <i class="bi bi-shield-fill-check"></i> Check if masks are required for safety
            </div>
          </div>
        </div>

        <div class="mb-0">
          <%= f.label :location_id, "Location", class: "form-label" %>
          <%= f.collection_select :location_id, Location.alphabetical, :id, :name,
              { prompt: "No specific location", include_blank: true },
              class: "form-select" %>
          <small class="form-text text-muted">
            <i class="bi bi-geo-alt"></i> Where this event typically happens
          </small>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 3: Scheduling -->
  <div class="wizard-panel" data-step="3" style="display: none;">
    <div class="card mb-3"
         data-controller="conflict-check"
         data-conflict-check-url-value="<%= conflict_check_events_path %>"
         data-conflict-check-event-id-value="<%= event.persisted? ? event.id : '' %>">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Scheduling</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <%= f.label :start_time, "Start Date & Time", class: "form-label" %>
            <%= f.datetime_local_field :start_time, class: "form-control", required: true %>
          </div>

          <div class="col-md-6 mb-3">
            <%= f.label :duration, "Duration (minutes)", class: "form-label" %>
            <%= f.number_field :duration, class: "form-control", value: event.duration || 60, min: 15, step: 15 %>
          </div>
        </div>

        <div class="row">
          <div class="col-md-8 mb-3">
            <%= f.label :recurrence_type, "Recurrence Pattern", class: "form-label" %>
            <%= f.select :recurrence_type, 
                [['One Time Event', 'once'], 
                 ['Weekly', 'weekly'], 
                 ['Monthly', 'monthly'],
                 ['Custom', 'custom']], 
                {}, 
                class: "form-select", 
                id: "recurrence_type_select" %>
          </div>

          <div class="col-md-4 mb-3" id="max_occurrences_field">
            <%= f.label :max_occurrences, "Show Next", class: "form-label" %>
            <%= f.number_field :max_occurrences, class: "form-control", value: event.max_occurrences || 5, min: 1, max: 20 %>
            <small class="form-text text-muted">Number of occurrences to display</small>
          </div>
        </div>

        <% weekly_schedule = parse_weekly_recurrence(event) %>
        <div id="weekly_options" class="mb-3" style="display: none;">
          <div class="alert alert-info py-2 mb-3">
            <small>
              <i class="bi bi-info-circle"></i>
              <strong>Examples:</strong> Select "Every 2 weeks" for biweekly events.
              Check multiple days for events on different days each week.
            </small>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Repeat every:</label>
              <%= select_tag :recurrence_interval,
                  options_for_select([
                    ['Every week', 1],
                    ['Every 2 weeks', 2],
                    ['Every 3 weeks', 3],
                    ['Every 4 weeks', 4]
                  ], weekly_schedule[:interval]),
                  class: "form-select" %>
            </div>
            <div class="col-md-8 mb-3">
              <label class="form-label">On which day(s):</label>
              <div class="d-flex flex-wrap gap-3">
                <% [['Sun', 0], ['Mon', 1], ['Tue', 2], ['Wed', 3], ['Thu', 4], ['Fri', 5], ['Sat', 6]].each do |label, value| %>
                  <div class="form-check">
                    <%= check_box_tag "recurrence_days[]", value, weekly_schedule[:days].include?(value), id: "weekly_day_#{value}", class: "form-check-input weekly-day-checkbox" %>
                    <%= label_tag "weekly_day_#{value}", label, class: "form-check-label" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <% monthly_schedule = parse_monthly_recurrence(event) %>
        <div id="monthly_options" class="mb-3" style="display: none;">
          <div class="alert alert-info py-2 mb-3">
            <small>
              <i class="bi bi-info-circle"></i>
              <strong>Examples:</strong> Check "First" and "Third" with "Monday" for 1st and 3rd Monday events.
            </small>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Which week(s):</label>
              <div class="d-flex flex-column gap-2">
                <% [['First', 'first'], ['Second', 'second'], ['Third', 'third'], ['Fourth', 'fourth'], ['Last', 'last']].each do |label, value| %>
                  <div class="form-check">
                    <%= check_box_tag "recurrence_occurrences[]", value, monthly_schedule[:occurrences].include?(value), id: "occurrence_#{value}", class: "form-check-input" %>
                    <%= label_tag "occurrence_#{value}", label, class: "form-check-label" %>
                  </div>
                <% end %>
              </div>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Except:</label>
              <div class="d-flex flex-column gap-2">
                <% [['First', 'first'], ['Second', 'second'], ['Third', 'third'], ['Fourth', 'fourth'], ['Last', 'last']].each do |label, value| %>
                  <div class="form-check">
                    <%= check_box_tag "recurrence_except_occurrences[]", value, monthly_schedule[:except_occurrences]&.include?(value), id: "except_occurrence_#{value}", class: "form-check-input" %>
                    <%= label_tag "except_occurrence_#{value}", label, class: "form-check-label text-muted" %>
                  </div>
                <% end %>
              </div>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">On which day:</label>
              <%= select_tag :recurrence_day,
                  options_for_select([
                    ['Monday', 'monday'], ['Tuesday', 'tuesday'], ['Wednesday', 'wednesday'],
                    ['Thursday', 'thursday'], ['Friday', 'friday'], ['Saturday', 'saturday'], ['Sunday', 'sunday']
                  ], monthly_schedule[:day]),
                  class: "form-select" %>
            </div>
          </div>
        </div>

        <div id="custom_options" class="mb-3" style="display: none;">
          <div class="alert alert-warning py-2 mb-3">
            <small>
              <i class="bi bi-exclamation-triangle"></i>
              <strong>Advanced:</strong> For alternating patterns, add multiple rules with different "Start on" weeks.
            </small>
          </div>
          <div id="custom_rules_container"></div>
          <button type="button" class="btn btn-outline-secondary btn-sm" id="add_custom_rule">
            <i class="bi bi-plus-circle"></i> Add Rule
          </button>
        </div>

        <%= render "scheduling_impact", f: f, event: event %>

        <h6 class="text-muted mb-3">Event Status Options</h6>

        <div class="mb-3">
          <div class="form-check">
            <%= f.check_box :default_to_cancelled, class: "form-check-input" %>
            <%= f.label :default_to_cancelled, "Default to Cancelled", class: "form-check-label text-warning" %>
            <div class="form-text text-warning">
              <i class="bi bi-calendar-x"></i> New occurrences created as cancelled. Useful for "every week except one" patterns.
            </div>
          </div>
        </div>

        <div class="mb-3">
          <div class="form-check">
            <%= f.check_box :permanently_cancelled, class: "form-check-input" %>
            <%= f.label :permanently_cancelled, "Permanently Cancelled", class: "form-check-label text-danger" %>
            <div class="form-text text-danger">
              <i class="bi bi-x-circle-fill"></i> Event is no longer running. No new occurrences generated.
            </div>
          </div>
        </div>

        <div class="mb-0">
          <div class="form-check">
            <%= f.check_box :permanently_relocated, class: "form-check-input", id: "permanently_relocated_checkbox" %>
            <%= f.label :permanently_relocated, "Permanently Relocated", class: "form-check-label text-info" %>
            <div class="form-text text-info">
              <i class="bi bi-geo-alt-fill"></i> Event has moved to a new location permanently.
            </div>
          </div>
          <div id="relocated_to_field" class="mt-2 ms-4" style="display: <%= event.permanently_relocated? ? 'block' : 'none' %>;">
            <%= f.label :relocated_to, "New Location", class: "form-label" %>
            <%= f.text_field :relocated_to, class: "form-control", placeholder: "e.g., New venue name, address, or URL" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 4: Visibility -->
  <div class="wizard-panel" data-step="4" style="display: none;">
    <div class="card mb-3">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-person-check"></i> RSVPs</h5>
      </div>
      <div class="card-body">
        <div class="form-check mb-3">
          <%= f.check_box :rsvp_enabled, class: "form-check-input" %>
          <%= f.label :rsvp_enabled, "Take RSVPs", class: "form-check-label" %>
          <div class="form-text">People RSVP to each date separately.</div>
        </div>
        <div class="row">
          <div class="col-md-4 mb-3">
            <%= f.label :capacity, "Capacity", class: "form-label" %>
            <%= f.number_field :capacity, class: "form-control", min: 1 %>
            <div class="form-text">Blank means unlimited.</div>
          </div>
          <div class="col-md-4 mb-3">
            <%= f.label :waitlist_mode, "When a spot opens", class: "form-label" %>
            <%= f.select :waitlist_mode, [['First come, first served', 'first_come'], ['Offer to one person at a time', 'sequential']], {}, class: "form-select" %>
          </div>
          <div class="col-md-4 mb-3">
            <%= f.label :rsvp_closes_minutes_before, "Close RSVPs (minutes before)", class: "form-label" %>
            <%= f.number_field :rsvp_closes_minutes_before, class: "form-control", min: 0 %>
          </div>
        </div>
        <div class="form-check">
          <%= f.check_box :waitlist_enabled, class: "form-check-input" %>
          <%= f.label :waitlist_enabled, "Keep a wait list when full", class: "form-check-label" %>
        </div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-envelope"></i> Contact hosts</h5>
      </div>
      <div class="card-body">
        <div class="form-check mb-0">
          <%= f.check_box :allow_host_contact, class: "form-check-input" %>
          <%= f.label :allow_host_contact, "Allow people to contact the hosts", class: "form-check-label" %>
          <div class="form-text">
            Adds a contact button on this event and each date. Messages are emailed to every host.
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-eye"></i> Visibility & Publishing</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <%= f.label :visibility, "Event Visibility", class: "form-label" %>
            <%= f.select :visibility, 
                [
                  ['Public - Anyone can view', 'public'],
                  ['Members Only - Signed in users can view', 'members'],
                  ['Private - Only you and admins can view', 'private']
                ], 
                {}, 
                class: "form-select" %>
            <small class="form-text text-muted">Who can see this event</small>
          </div>

          <div class="col-md-6 mb-3">
            <%= f.label :open_to, "Open To", class: "form-label" %>
            <%= f.select :open_to, 
                [
                  ['Public - Open to everyone', 'public'],
                  ['Members Only - Members can attend', 'members'],
                  ['Private - Invitation only', 'private']
                ], 
                {}, 
                class: "form-select" %>
            <small class="form-text text-muted">Who can attend this event</small>
          </div>
        </div>

        <div class="mb-3">
          <div class="form-check">
            <%= f.check_box :draft, class: "form-check-input" %>
            <%= f.label :draft, "Save as Draft", class: "form-check-label" %>
            <div class="form-text">
              <i class="bi bi-file-earmark-text"></i> Draft events are only visible to you
            </div>
          </div>
        </div>

        <div class="mb-0">
          <div class="form-check">
            <%= f.check_box :sign_feed, class: "form-check-input" %>
            <%= f.label :sign_feed, "Show on E-Ink Signs", class: "form-check-label" %>
            <div class="form-text">
              <i class="bi bi-display"></i> Include in e-ink display sign feed
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 5: Promotion -->
  <div class="wizard-panel" data-step="5" style="display: none;">
    <% site_config = SiteConfig.current %>
    <% if site_config.slack_enabled? || site_config.social_reminders_enabled? %>
      <% ollama_configured = OllamaService.configured? %>
      <% short_max = site_config.short_reminder_max_length %>
      <% long_max = site_config.long_reminder_max_length %>
      <div class="card mb-3" id="reminder-messages-section"
           data-generate-ai-url="<%= event.persisted? ? generate_ai_reminder_event_path(event) : '' %>"
           data-ai-event-description="<%= h(event.description.to_s) %>">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-megaphone"></i> Promotion & Reminders</h5>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-6">
              <div class="form-check">
                <%= f.check_box :slack_announce, class: "form-check-input" %>
                <%= f.label :slack_announce, "Post to Slack", class: "form-check-label" %>
                <div class="form-text">
                  <i class="bi bi-slack"></i> Reminders posted 6 days and 1 day before
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-check">
                <%= f.check_box :social_reminders, class: "form-check-input" %>
                <%= f.label :social_reminders, "Post to Social Media", class: "form-check-label" %>
                <div class="form-text">
                  <i class="bi bi-share"></i> Instagram and Bluesky reminders
                </div>
              </div>
            </div>
          </div>

          <hr class="my-3">

          <div class="alert alert-info py-2 mb-3" role="note">
            <small>
              <i class="bi bi-info-circle" aria-hidden="true"></i>
              <strong>Tip:</strong> Use <code>{{when}}</code> as a placeholder for the date/time.
            </small>
          </div>

          <h6 class="text-muted mb-3">6-Day Reminders</h6>
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :reminder_7d_short, "Short (#{short_max} chars)", class: "form-label" %>
              <%= f.text_area :reminder_7d_short, 
                  class: "form-control", 
                  rows: 3, 
                  maxlength: short_max,
                  id: "event_reminder_7d_short",
                  placeholder: event.reminder_short_default(7),
                  data: { default_text: event.reminder_short_default(7) } %>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <small class="text-muted char-count" data-target="event_reminder_7d_short">0/<%= short_max %></small>
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-secondary btn-sm" data-action="set-default" data-target="event_reminder_7d_short">Default</button>
                  <% if ollama_configured && event.persisted? %>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-action="regenerate" data-target="event_reminder_7d_short" data-type="short"><i class="bi bi-stars"></i> AI</button>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :reminder_7d_long, "Long (#{long_max} chars)", class: "form-label" %>
              <%= f.text_area :reminder_7d_long, 
                  class: "form-control", 
                  rows: 3, 
                  maxlength: long_max,
                  id: "event_reminder_7d_long",
                  placeholder: event.reminder_long_default(7),
                  data: { default_text: event.reminder_long_default(7) } %>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <small class="text-muted char-count" data-target="event_reminder_7d_long">0/<%= long_max %></small>
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-secondary btn-sm" data-action="set-default" data-target="event_reminder_7d_long">Default</button>
                  <% if ollama_configured && event.persisted? %>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-action="regenerate" data-target="event_reminder_7d_long" data-type="long"><i class="bi bi-stars"></i> AI</button>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <h6 class="text-muted mb-3">1-Day Reminders</h6>
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :reminder_1d_short, "Short (#{short_max} chars)", class: "form-label" %>
              <%= f.text_area :reminder_1d_short, 
                  class: "form-control", 
                  rows: 3, 
                  maxlength: short_max,
                  id: "event_reminder_1d_short",
                  placeholder: event.reminder_short_default(1),
                  data: { default_text: event.reminder_short_default(1) } %>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <small class="text-muted char-count" data-target="event_reminder_1d_short">0/<%= short_max %></small>
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-secondary btn-sm" data-action="set-default" data-target="event_reminder_1d_short">Default</button>
                  <% if ollama_configured && event.persisted? %>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-action="regenerate" data-target="event_reminder_1d_short" data-type="short"><i class="bi bi-stars"></i> AI</button>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :reminder_1d_long, "Long (#{long_max} chars)", class: "form-label" %>
              <%= f.text_area :reminder_1d_long, 
                  class: "form-control", 
                  rows: 3, 
                  maxlength: long_max,
                  id: "event_reminder_1d_long",
                  placeholder: event.reminder_long_default(1),
                  data: { default_text: event.reminder_long_default(1) } %>
              <div class="d-flex justify-content-between align-items-center mt-1">
                <small class="text-muted char-count" data-target="event_reminder_1d_long">0/<%= long_max %></small>
                <div class="btn-group btn-group-sm">
                  <button type="button" class="btn btn-outline-secondary btn-sm" data-action="set-default" data-target="event_reminder_1d_long">Default</button>
                  <% if ollama_configured && event.persisted? %>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-action="regenerate" data-target="event_reminder_1d_long" data-type="long"><i class="bi bi-stars"></i> AI</button>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="card mb-3">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-megaphone"></i> Promotion & Reminders</h5>
        </div>
        <div class="card-body">
          <div class="alert alert-secondary mb-0">
            <i class="bi bi-info-circle"></i> Slack and social media integrations are not configured.
          </div>
        </div>
      </div>
    <% end %>
  </div>

<% end %>

  <!-- Step 2: Images. Outside the event form because the pool manages itself
       through its own forms, which cannot be nested inside another form. -->
  <div class="wizard-panel" data-step="2" style="display: none;">
    <%= render 'image_pool', event: event %>
  </div>

  <!-- Navigation Buttons -->
  <div class="d-flex justify-content-between mt-4">
    <div>
      <button type="button" class="btn btn-outline-secondary wizard-prev-btn" style="display: none;">
        <i class="bi bi-arrow-left"></i> Previous
      </button>
    </div>
    <div>
      <%= link_to event.persisted? ? "Cancel Edit" : "Cancel", events_path, class: "btn btn-secondary me-2" %>
      <% if event.persisted? %>
        <%= submit_tag "Save and Exit",
                       form: 'event-wizard-form',
                       class: "btn btn-outline-success wizard-save-exit-btn me-2",
                       style: "display: none;" %>
      <% end %>
      <button type="button" class="btn btn-primary wizard-next-btn">
        Next <i class="bi bi-arrow-right"></i>
      </button>
      <%= submit_tag event.persisted? ? "Update Event" : "Create Event",
                     form: 'event-wizard-form',
                     class: "btn btn-success wizard-submit-btn",
                     style: "display: none;" %>
    </div>
  </div>
</div>

<style>
  .wizard-steps {
    counter-reset: step;
  }
  
  /* Connector line spans centre-to-centre, so it insets by half a step. */
  .wizard-steps::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 10%;
    right: 10%;
    height: 2px;
    background: #dee2e6;
    z-index: 0;
  }
  
  .wizard-step-number {
    width: 36px;
    height: 36px;
    background: #dee2e6;
    color: #6c757d;
    font-weight: bold;
    position: relative;
    z-index: 1;
    transition: all 0.3s ease;
  }
  
  .wizard-step-label {
    color: #6c757d;
    transition: all 0.3s ease;
  }
  
  .wizard-step.active .wizard-step-number {
    background: #0d6efd;
    color: white;
  }
  
  .wizard-step.active .wizard-step-label {
    color: #0d6efd;
    font-weight: 500;
  }
  
  .wizard-step.completed .wizard-step-number {
    background: #198754;
    color: white;
  }
  
  .wizard-step.completed .wizard-step-label {
    color: #198754;
  }
  
  .wizard-step-btn:hover .wizard-step-number {
    transform: scale(1.1);
  }
  
  .wizard-step-btn:focus {
    outline: none;
    box-shadow: none;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', initEventWizard);
document.addEventListener('turbo:load', initEventWizard);

function initEventWizard() {
  const wizard = document.getElementById('event-wizard');
  if (!wizard) return;
  
  let currentStep = 1;
  const totalSteps = parseInt(wizard.dataset.totalSteps);
  
  const panels = wizard.querySelectorAll('.wizard-panel');
  const steps = wizard.querySelectorAll('.wizard-step');
  const prevBtn = wizard.querySelector('.wizard-prev-btn');
  const nextBtn = wizard.querySelector('.wizard-next-btn');
  const submitBtn = wizard.querySelector('.wizard-submit-btn');
  const saveExitBtn = wizard.querySelector('.wizard-save-exit-btn');
  
  function showStep(step, { scroll = true } = {}) {
    currentStep = step;
    
    // Show/hide panels
    panels.forEach(panel => {
      panel.style.display = parseInt(panel.dataset.step) === step ? 'block' : 'none';
    });
    
    // Update step indicators
    steps.forEach(s => {
      const stepNum = parseInt(s.dataset.step);
      s.classList.remove('active', 'completed');
      if (stepNum === step) {
        s.classList.add('active');
      } else if (stepNum < step) {
        s.classList.add('completed');
      }
    });
    
    // Update buttons
    prevBtn.style.display = step > 1 ? 'inline-block' : 'none';
    nextBtn.style.display = step < totalSteps ? 'inline-block' : 'none';
    submitBtn.style.display = step === totalSteps ? 'inline-block' : 'none';
    // On the last step the submit button already saves and leaves.
    if (saveExitBtn) {
      saveExitBtn.style.display = step < totalSteps ? 'inline-block' : 'none';
    }
    
    // Scroll to top of wizard
    if (scroll) {
      wizard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  
  function validateStep(step) {
    const panel = wizard.querySelector(`.wizard-panel[data-step="${step}"]`);
    let valid = true;
    
    // checkValidity covers more than an empty field: a malformed More Info URL
    // or a duration off the 15-minute step blocks submission just as surely.
    // A required field holding only spaces passes it but not the model.
    panel.querySelectorAll('input, select, textarea').forEach(field => {
      const blank = field.required && !field.value.trim();
      
      if (!field.disabled && (blank || !field.checkValidity())) {
        field.classList.add('is-invalid');
        valid = false;
      } else {
        field.classList.remove('is-invalid');
      }
    });
    
    return valid;
  }
  
  // A rejected field can be off-screen, or on a panel that is not even open, so
  // every control that validates has to bring it into view and let the browser
  // say what is wrong. Otherwise the control just appears to do nothing.
  function validateAndReport(step) {
    if (validateStep(step)) return true;
    
    if (currentStep !== step) showStep(step, { scroll: false });
    
    // Focusing scrolls the field into view at once. The smooth scroll showStep
    // normally runs would still be going when the bubble appears, and Chromium
    // dismisses the bubble as soon as anything scrolls.
    const field = wizard.querySelector(`.wizard-panel[data-step="${step}"] .is-invalid`);
    field.focus();
    field.reportValidity();
    
    return false;
  }
  
  function validateAllSteps() {
    // This stops at the first bad step, so marks left on later ones by an
    // earlier attempt would linger after the field behind them was fixed.
    wizard.querySelectorAll('.is-invalid').forEach(field => field.classList.remove('is-invalid'));
    
    for (let step = 1; step <= totalSteps; step++) {
      if (!validateAndReport(step)) return false;
    }
    
    return true;
  }
  
  // Navigation buttons
  prevBtn.addEventListener('click', () => {
    if (currentStep > 1) showStep(currentStep - 1);
  });
  
  nextBtn.addEventListener('click', () => {
    if (validateAndReport(currentStep) && currentStep < totalSteps) {
      showStep(currentStep + 1);
    }
  });
  
  // Every panel belongs to the same form, so either save button submits all of
  // them from whichever step is open, and the browser refuses while any field
  // is invalid. Checking every step first is what makes it possible to open the
  // one holding the problem.
  [saveExitBtn, submitBtn].forEach(btn => {
    if (!btn) return;
    
    btn.addEventListener('click', (clickEvent) => {
      if (!validateAllSteps()) clickEvent.preventDefault();
    });
  });

  // Step indicator clicks
  steps.forEach(step => {
    const btn = step.querySelector('.wizard-step-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        const targetStep = parseInt(btn.dataset.gotoStep);
        // Allow going back freely, but validate when going forward
        if (targetStep < currentStep || validateAndReport(currentStep)) {
          showStep(targetStep);
        }
      });
    }
  });
  
  // The image pool redirects back with #image-pool, so open on that step.
  showStep(window.location.hash === '#image-pool' ? 2 : 1);
  
  // Initialize recurrence options (from original form)
  initRecurrenceOptions();
  initReminderButtons();
  initCharCounts();
  initRelocatedField();
}

// Include the original form's JavaScript functions
<%= render 'events/wizard_scripts' %>
</script>
